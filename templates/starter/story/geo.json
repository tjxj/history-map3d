// ============================================================
// 地理底图参数（geo.json）。默认值能用；要加古河道、古湖、疆域、长城时看 references/spec.md「geo.json」
// ============================================================
{
  // 地图范围 [西, 南, 东, 北]。不写就按全部地点自动算（四周各留 3–4 度）
  // "bbox": [100, 24, 124, 42],

  // 河流。"auto"：自动画范围内的大河，名字用 Natural Earth 自带的中文名
  // maxScalerank 越大画的河越多（6 只画大河，8 画到较大的支流）
  // 想自己挑河、改名字：先运行 python3 scripts/geo.py rivers 西,南,东,北，再把 "ne" 改成 {"英文名": "图上中文名", …}
  "rivers": {"ne": "auto", "maxScalerank": 6, "rdp": 0.006},
  "lakes": {"maxScalerank": 8}
}
