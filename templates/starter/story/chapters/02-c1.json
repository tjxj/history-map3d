// ============================================================
// 有路线的章（人物一生的一段行程）。复制这个文件做下一章：03-c2.json、04-c3.json ……
// track：这一章依次走哪几条路线（routes.json 的 id）
// stops：路过某个地点时发生什么。toast 是一句提示；scene 是一场演出（镜头停下来，字幕、特效、音效）
// 每章挑最重要的 1–3 件事写成 scene，其余写 toast。场景写法见 references/scenes.md
// 战争题材的写法照抄 examples/huoqubing/story/chapters/
// ============================================================
{
  "id": "c1",
  "y": 0,
  "num": "壹",
  "title": "TODO",
  "sub": "TODO 一句副标题",
  "era": "TODO 年号",
  "year": "TODO 年份",
  "age": "TODO 岁",               // 例「二十五岁」（≤ 6 字）
  "rank": "TODO 身份",            // 例「布衣」；身份有变化写「甲 → 乙」（≤ 16 字）
  "color": "#f0b45a",
  "atmo": "spring",
  "view": {"c": [108.2, 30.3], "z": 5.2, "p": 50, "b": 0},
  "lead": "TODO 导语（≤ 70 字）",
  "kpis": [
    {"v": 0, "u": "首", "l": "TODO 数字说明", "s": "TODO 出处"},
    {"v": 0, "u": "岁", "l": "TODO 数字说明", "s": "TODO 出处"}
  ],
  // 文字里可以写 {km:起点>终点}，网页上自动换成沿路线的公里数（两个点都要在本章路线上）
  "story": [
    "TODO 第一段。本章行程约 {km:place_a>place_c} 公里。",
    "TODO 第二段"
  ],
  "timeline": [
    {"t": "TODO", "h": "TODO 事件", "d": "TODO 一句话", "at": "place_a"},
    {"t": "TODO", "h": "TODO 事件", "d": "TODO 一句话", "at": "place_b"},
    {"t": "TODO", "h": "TODO 事件", "d": "TODO 一句话", "at": "place_c"}
  ],
  "sources": [
    {"s": "《TODO》", "t": "TODO 原文"},
    {"s": "《TODO》", "t": "TODO 原文"}
  ],
  // 异文：k 条目（≤ 6 字），a 甲本写法，b 乙本写法，h 按语（≤ 60 字）。没有就写 []
  "variants": [
    {"k": "TODO", "a": "TODO 甲本写法", "b": "TODO 乙本写法", "h": "TODO 按语"}
  ],
  // 考据：一个有争议的问题，列出各家说法；at 是每种说法对应的地点（点击后地图飞过去）
  "debates": [
    {
      "t": "TODO 有争议的问题？",
      "q": "TODO 争议是什么、本图取哪一说（≤ 110 字）",
      "opts": [
        {"n": "TODO 说法一", "tag": "主流", "at": "place_b", "d": "TODO 依据"},
        {"n": "TODO 说法二", "tag": "一说", "at": "place_c", "d": "TODO 依据"}
      ]
    }
  ],
  "people": [
    {"n": "TODO 人名", "side": "me", "r": "TODO 身份", "d": "TODO 一句话"}
  ],

  // v 是播放速度倍数：几十公里写 0.6–1.2，几百公里 1.5–3，上千公里 3–5
  // cap 是这段路一句话（≤ 30 字），who 是地图上行进标记的名字（≤ 16 字）；dash: true 画成虚线（返程、推测的路）
  "track": [
    {"r": "r1", "v": 2, "cap": "TODO 这段路一句话", "who": "TODO 行进标记名"},
    {"r": "r2", "v": 1.2, "cap": "TODO 这段路一句话", "who": "TODO 行进标记名"}
  ],
  "stops": {
    "place_a": {"toast": "TODO 路过时弹出的一句话（≤ 44 字）"},

    // 舟行场景：move 特效加 boat: true 画一叶小舟，从 at 划到 to（坐标是相对场景中心的 [向东公里, 向北公里]）
    "place_b": {"scene": {
      "kind": "voyage",
      "kicker": "TODO 时间 · 地点",  // ≤ 14 字
      "title": "TODO 场景名",        // ≤ 10 字最好看（上限 12）
      "at": "place_b", "z": 9, "p": 62, "b": 30, "orbit": 16, "dur": 14,
      "weather": "mist",
      "stats": [{"v": 0, "u": "里", "l": "TODO 数字说明"}, {"t": "TODO", "l": "TODO 说明"}],
      "quote": {"t": "TODO 原文（≤ 40 字）", "s": "《TODO》"},
      "lines": [[0, "TODO 第一句字幕（≤ 34 字）"], [4.5, "TODO 第二句"], [9, "TODO 第三句"]],
      "fx": [{"k": "move", "at": [-16, -4], "to": [14, 5], "t0": 0.5, "t1": 12, "boat": true, "side": "gold", "label": "TODO"}],
      "sfx": [[0, "water"], [0.4, "qin"]]
    }},

    // 诗作场景：poem 是竖排诗卡，l 一行一句（每句 ≤ 16 字，最多 12 句）；dur 至少 0.4 + 句数 × 1.5 + 3 秒
    "place_c": {"scene": {
      "kind": "poem",
      "kicker": "TODO 时间 · 地点",
      "title": "TODO 诗题",
      "at": "place_c", "z": 9.2, "p": 60, "b": -20, "orbit": 12, "dur": 14,
      "weather": "petals",
      "poem": {"t": "TODO 诗题", "a": "{{NAME}}", "l": ["TODO 第一句", "TODO 第二句", "TODO 第三句", "TODO 第四句"], "s": "《TODO》卷几"},
      "lines": [[0, "TODO 写这首诗的缘由"], [6, "TODO 第二句字幕"]],
      "sfx": [[0, "qin"], [6, "bell"]]
    }}
  }
}
