// ============================================================
// 序章：用巡游镜头 tour 交代时代背景和出身，不走路线。2–4 个镜头，每个 8–12 秒
// 每一章都必须有：id、num、title、sub、lead、color、view，再加 track（走路线）或 tour（巡游镜头）二选一
// 文件名前两位数字决定章节顺序：01-、02-、03- ……
// ============================================================
{
  "id": "prologue",
  "y": 0,                         // 这一章开始的公元年份（公元前写负数），只用来检查章节顺序有没有排错
  "num": "序",
  "title": "TODO",                // 章标题，≤ 5 字最好看（上限 6）
  "sub": "TODO 一句副标题",        // ≤ 24 字
  "era": "TODO 年号",             // ≤ 12 字，例「开元」
  "year": "TODO 年份",            // ≤ 14 字，例「701 — 724」
  "age": "—",                     // 主角年龄；序章写 —
  "rank": "—",                    // 主角身份；序章写 —
  "color": "#d9b26a",             // 章节主色 #rrggbb，相邻两章换不同颜色
  "atmo": "dusk",                 // 氛围：dusk dawn spring summer autumn steppe night rain snow moon mist blossom
  "view": {"c": [108.2, 30.3], "z": 4.6, "p": 40, "b": 0},   // 开场镜头：c 中心 [经度, 纬度]，z 缩放（4 看几省，6 看一城），p 俯仰 0–75，b 朝向
  "lead": "TODO 导语：这一章讲什么，一两句（≤ 70 字）",

  // 数字卡 2–4 个：v 数字，u 单位（≤ 2 字），l 说明（≤ 12 字），s 出处或年份（≤ 14 字）。每个数字先记进 research/facts.md
  "kpis": [
    {"v": 0, "u": "年", "l": "TODO 数字说明", "s": "TODO 出处"}
  ],
  // 「经过」段落 2–4 段，每段一件事，≤ 140 字
  "story": [
    "TODO 第一段：时代背景",
    "TODO 第二段：出身与家世"
  ],
  // 时间线：t 时间（≤ 6 字），h 标题（≤ 14 字），d 一句话（≤ 36 字），at 地点键名（点击后地图飞过去）
  "timeline": [
    {"t": "TODO", "h": "TODO 事件", "d": "TODO 一句话", "at": "place_a"}
  ],
  // 史料原文：s 写《书名·篇名》，t 照抄 research/ 里核对过的原文
  "sources": [
    {"s": "《TODO》", "t": "TODO 原文"}
  ],
  "variants": [],
  "debates": [],
  // 人物：side 写 site.json factions 的 k（me 主角一方，other 对方）
  "people": [
    {"n": "{{NAME}}", "side": "me", "r": "TODO 身份", "d": "TODO 一句话"}
  ],

  // 巡游镜头：at 地点键名或 [经度, 纬度]；z 缩放（7–9 看清一城）；dur 秒数；h 小标题（≤ 12 字最好看）；d 说明（≤ 70 字）
  // fx 特效的坐标是相对 at 的 [向东公里, 向北公里]；能用的特效、音效见 references/scenes.md
  "tour": [
    {
      "at": "place_a", "z": 7.5, "p": 55, "b": 15, "dur": 9,
      "h": "TODO · 小标题",
      "d": "TODO 这个镜头讲的事",
      "fx": [{"k": "pulse", "at": [0, 0], "t0": 0.5, "t1": 9, "side": "gold"}],
      "sfx": [[0.3, "qin"]]
    },
    {
      "at": "place_b", "z": 6.8, "p": 50, "b": -10, "dur": 9,
      "h": "TODO · 小标题",
      "d": "TODO 这个镜头讲的事",
      "fx": [{"k": "ring", "at": [0, 0], "r": 14, "side": "other", "t0": 0.5, "t1": 9}],
      "sfx": [[0.3, "bell"]]
    }
  ]
}
