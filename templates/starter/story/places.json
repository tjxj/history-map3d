// ============================================================
// 地点表（places.json）
// 键名：英文字母开头，用拼音小写，例如 "jiangling"、"baidi"。章节里的 stops、timeline.at、场景 at 都写这个键名
// n：图上显示的古地名（≤ 10 字）；d：今地（≤ 20 字），例「今湖北荆州」
// ll：[经度, 纬度]，经度在前。坐标来自 research/places.md 的考据，查到小数点后两位
//     写完用 python3 scripts/geo.py near 经度 纬度 核对：海拔对不对、离河多远
// 不写 n 的点只用来让路线拐弯，不显示，也不能当停靠点
// 下面三个点是占位（成都、重庆、荆州的坐标），全部换成你的人物去过的地方
// ============================================================
{
  "place_a": {"n": "TODO 起点", "d": "TODO 今地", "ll": [104.07, 30.67]},
  "place_b": {"n": "TODO 江边", "d": "TODO 今地", "ll": [106.55, 29.56]},
  "place_c": {"n": "TODO 终点", "d": "TODO 今地", "ll": [112.24, 30.35]}
}
