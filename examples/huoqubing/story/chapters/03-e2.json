  "debates": [
    {
      "t": "乌盭在哪里？",
      "q": "「逾」字说明是一道山险。主流把它放在乌鞘岭至靖远屈吴山一线，即陇西入河西的东端分水岭。",
      "opts": [
        {"n": "乌鞘岭", "tag": "主流", "at": "wushaoling", "d": "今天祝境，海拔三千米上下的垭口，至今为河西门户。"},
        {"n": "屈吴山", "tag": "一说", "at": "wushaoling_alt", "d": "靖远—平川一带，音近「乌盭」。"}
      ]
    },
    {
      "t": "狐奴水是哪条河？",
      "q": "唐代注家以来多指武威境内的石羊河水系，少数考证指向庄浪河或祖厉河。",
      "opts": [
        {"n": "石羊河", "tag": "主流", "at": "hunu", "d": "武威绿洲的母亲河，休屠王牧地核心。"},
        {"n": "庄浪河", "tag": "一说", "at": "hunu_alt", "d": "自乌鞘岭南流入黄河。"}
      ]
    },
    {
      "t": "「鏖皋兰下」的皋兰在哪里？",
      "q": "这是河西春战最大的地理争议。诏书的行文顺序是「过焉支山千有余里」之后才「合短兵」，决战地应在焉支山以西；可兰州南山自古也叫皋兰山。",
      "opts": [
        {"n": "河西走廊中段山地", "tag": "本图主线", "at": "gaolan_h", "d": "临泽—高台间，与「过焉支山千有余里」的先后顺序相合。"},
        {"n": "兰州皋兰山", "tag": "传统说", "at": "gaolan_t", "d": "地名沿用至今；若取此说，决战发生在回师途中。"},
        {"n": "临夏石门山", "tag": "《水经注》系统", "at": "gaolan_s", "d": "应劭称「皋兰在陇西白石塞外」；多认为距焉支山过远。"}
      ]
    },
    {
      "t": "「千有余里」有多远？",
      "q": "按一汉里约 415.8 米折算，千里约合 416 公里。本图主线自焉支山北麓至决战地约 {km:yanzhi_n>gaolan_h} 公里，单程不足千里；若计入往返转战，与「千有余里」大致相当。",
      "opts": []
    }
  ],
