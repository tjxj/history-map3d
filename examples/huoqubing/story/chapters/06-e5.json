  "debates": [
    {
      "t": "狼居胥山在哪里？",
      "q": "主流认为在今蒙古国肯特山。另有两种意见把它放在内蒙古境内，与「绝大幕」「出代二千余里」的里程难以相合。",
      "opts": [
        {"n": "肯特山", "tag": "主流", "at": "langjuxu", "d": "蒙古高原东北部的圣山山系，克鲁伦河、鄂嫩河、土拉河皆发源于此。"},
        {"n": "克什克腾旗一带", "tag": "里程缩近说", "at": "langjuxu_alt2", "d": "距汉塞过近。"},
        {"n": "阴山狼山", "tag": "一说", "at": "langshan", "d": "名称相近，位置在大漠之南，多不取。"}
      ]
    },
    {
      "t": "翰海是什么？",
      "q": "「登临翰海」的翰海，历来众说纷纭。张晏注：「登海边山以望海。」",
      "opts": [
        {"n": "贝加尔湖", "tag": "主流", "at": "hanhai", "d": "汉代称「北海」，苏武牧羊之地。本图以虚线示意。"},
        {"n": "呼伦湖", "tag": "一说", "at": "hulun", "d": "偏东较多。"},
        {"n": "杭爱山", "tag": "音转说", "at": "hangai", "d": "「翰海」即「杭爱」的音译。"}
      ]
    },
    {
      "t": "封与禅",
      "q": "古礼「封」为筑土为坛以祭天，在高山之巅；「禅」为辟除地面以祭地，在其旁的低山。姑衍山应在狼居胥附近，具体地望未定。",
      "opts": [{"n": "姑衍山", "tag": "推测", "at": "guyan", "d": "肯特山西北。"}]
    },
    {
      "t": "弓闾水与余吾水",
      "q": "弓闾（弓卢）即克鲁伦河，学界意见较一致。余吾水即土拉河，元狩二年「马生余吾水中」的祥瑞即出于此。",
      "opts": [{"n": "弓闾 · 克鲁伦河", "tag": "主流", "at": "gonglv", "d": "本图渡河点按史文顺序取于离侯之北。"}]
    }
