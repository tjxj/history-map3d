  "debates": [
    {
      "t": "居延是额济纳的居延海吗？",
      "q": "主流认为「济居延」就是渡过弱水下游、抵达额济纳的居延泽。也有学者据汉简里距与骑兵日行速度推测，渡河点可能偏南。",
      "opts": [
        {"n": "额济纳居延泽", "tag": "主流", "at": "juyan", "d": "汉代湖面远大于今日，本图以虚线示意。"},
        {"n": "金塔—鼎新弱水段", "tag": "南移说", "at": "juyan_alt", "d": "弱水中游，路程大为缩短。"}
      ]
    },
    {
      "t": "小月氏在哪里？",
      "q": "大月氏西迁后，留居祁连山间的余部称小月氏。",
