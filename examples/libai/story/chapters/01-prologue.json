  "sources": [
    {
      "s": "《新唐书·李白传》",
      "t": "李白，字太白，兴圣皇帝九世孙。其先隋末以罪徙西域，神龙初，遁还，客巴西。白之生，母梦长庚星，因以命之。十岁通诗书，既长，隐岷山。"
    },
    {
      "s": "《旧唐书·李白传》",
      "t": "初贺知章见白，赏之曰：「此天上谪仙人也。」"
    },
    {
      "s": "《李翰林集序》（魏颢）",
      "t": "白本陇西，乃放形，因家于绵。身既生蜀，则江山英秀。"
    },
    {
      "s": "《李太白年谱》（王琦）",
      "t": "长安元年辛丑，太白生。惊姜之夕长庚入梦，故名白以太白字之。"
    }
  ],
