  "sources": [
    {
      "s": "《草堂集序》（李阳冰）",
      "t": "阳冰试弦歌于当涂，心非所好，公遐不弃我，乘扁舟而相顾。临当挂冠，公又疾亟，草槁万卷，手集未修，枕上授简，俾余为序。"
    },
    {
      "s": "《李公新墓碑》（范传正）",
      "t": "晚岁渡牛渚矶，至姑熟，悦谢家青山，有终焉之志，盘桓利居，竟卒于此。"
    },
    {
      "s": "《新唐书·李白传》",
      "t": "李阳冰为当涂令，白依之。代宗立，以左拾遗召，而白已卒，年六十余。"
    },
    {
      "s": "《全唐诗·临路歌》",
      "t": "大鹏飞兮振八裔，中天摧兮力不济。余风激兮万世，游扶桑兮挂石袂。"
    }
  ],
